includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    ignoreErrors:
        -
            message: '#^Trait Matheusmarnt\\Scoutify\\Concerns\\Searchable is used zero times and is not analysed\.$#'
            identifier: trait.unused
            path: src/Concerns/Searchable.php
        -
            message: '#^Call to an undefined static method Livewire\\Livewire::addNamespace\(\)\.$#'
            identifier: staticMethod.notFound
            path: src/ScoutifyServiceProvider.php
        -
            message: '#^Call to an undefined static method Illuminate\\Database\\Eloquent\\Model::search\(\)\.$#'
            identifier: staticMethod.notFound
            path: src/Services/SearchAggregator.php
